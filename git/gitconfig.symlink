[user]
	name = joebutler2
	email = TheVagabondProgrammer@proton.me

[core]
	autocrlf = input
	excludesfile = ~/.gitignore_global
	editor = vim

[init]
	defaultBranch = main

[pull]
	rebase = false

[push]
	autoSetupRemote = true

[color]
	ui = auto

[alias]
	st = status -sb
	co = checkout
	br = branch
	ci = commit
	last = log -1 HEAD
	unstage = restore --staged
	amend = commit --amend --no-edit
