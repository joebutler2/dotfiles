#!/usr/bin/env bash
#
# bootstrap — symlink every *.symlink file into $HOME, and (on macOS) offer
# to install Homebrew packages from Brewfile. Safe to re-run.
#
# Convention borrowed from holman/dotfiles: any file named `foo.symlink`
# inside this repo gets linked to `~/.foo`.

set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BACKUP_DIR="$HOME/.dotfiles-backup/$(date +%Y%m%d%H%M%S)"

info()  { printf '\033[1;34m[bootstrap]\033[0m %s\n' "$1"; }
ok()    { printf '\033[1;32m[ok]\033[0m %s\n' "$1"; }
warn()  { printf '\033[1;33m[skip]\033[0m %s\n' "$1"; }

link_file() {
  local src="$1" dst="$2"

  if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
    warn "$dst already linked"
    return
  fi

  if [ -e "$dst" ] || [ -L "$dst" ]; then
    mkdir -p "$BACKUP_DIR"
    mv "$dst" "$BACKUP_DIR/"
    info "backed up existing $dst -> $BACKUP_DIR/"
  fi

  ln -s "$src" "$dst"
  ok "linked $dst -> $src"
}

info "linking dotfiles from $DOTFILES_ROOT"

while IFS= read -r -d '' src; do
  filename="$(basename "$src" .symlink)"
  dst="$HOME/.$filename"
  link_file "$src" "$dst"
done < <(find "$DOTFILES_ROOT" -maxdepth 2 -name '*.symlink' -print0)

if [ -x "$DOTFILES_ROOT/claude/install.sh" ]; then
  "$DOTFILES_ROOT/claude/install.sh"
fi

if [ -x "$DOTFILES_ROOT/pi/install.sh" ]; then
  "$DOTFILES_ROOT/pi/install.sh"
fi

install_packages_from_list() {
  local list_file="$1"
  shift
  local install_cmd=("$@")

  [ -f "$list_file" ] || return 0

  local packages=()
  while IFS= read -r line; do
    line="${line%%#*}"
    line="$(echo "$line" | xargs)"
    [ -n "$line" ] && packages+=("$line")
  done < "$list_file"

  [ "${#packages[@]}" -eq 0 ] && return 0

  read -r -p "Install ${#packages[@]} package(s) (${install_cmd[*]})? [y/N] " reply
  if [[ "$reply" =~ ^[Yy]$ ]]; then
    "${install_cmd[@]}" "${packages[@]}"
  fi
}

case "$(uname)" in
  Darwin)
    if command -v brew >/dev/null 2>&1; then
      if [ -f "$DOTFILES_ROOT/Brewfile" ]; then
        read -r -p "Run 'brew bundle' against Brewfile now? [y/N] " reply
        if [[ "$reply" =~ ^[Yy]$ ]]; then
          brew bundle --file="$DOTFILES_ROOT/Brewfile"
        fi
      fi
    else
      warn "Homebrew not found - skipping package install (see https://brew.sh)"
    fi
    ;;
  Linux)
    if command -v apt-get >/dev/null 2>&1; then
      install_packages_from_list "$DOTFILES_ROOT/linux/packages.apt" sudo apt-get install -y
    elif command -v dnf >/dev/null 2>&1; then
      install_packages_from_list "$DOTFILES_ROOT/linux/packages.dnf" sudo dnf install -y
    elif command -v pacman >/dev/null 2>&1; then
      install_packages_from_list "$DOTFILES_ROOT/linux/packages.pacman" sudo pacman -S --needed
    else
      warn "no supported package manager found (apt-get/dnf/pacman) - skipping package install"
    fi
    ;;
  *)
    warn "unrecognized platform $(uname) - skipping package install"
    ;;
esac

# mise (https://mise.jdx.dev) isn't reliably packaged in apt/dnf/pacman, so
# it's installed via its own official script rather than through the
# per-distro package lists above. Homebrew already covers it on macOS via
# the Brewfile; this is the fallback for everywhere else (and for macOS
# without Homebrew).
if ! command -v mise >/dev/null 2>&1; then
  read -r -p "mise not found - install it via https://mise.run now? [y/N] " reply
  if [[ "$reply" =~ ^[Yy]$ ]]; then
    curl -fsSL https://mise.run | sh
  fi
fi

# beads (`bd`) is in homebrew-core, so the Brewfile step above covers macOS
# and any Linux box with Homebrew. It isn't packaged in apt/dnf/pacman, so
# this is the fallback for everywhere else, same pattern as mise above.
if ! command -v bd >/dev/null 2>&1; then
  read -r -p "beads (bd) not found - install it via the official installer now? [y/N] " reply
  if [[ "$reply" =~ ^[Yy]$ ]]; then
    curl -fsSL https://raw.githubusercontent.com/steveyegge/beads/main/scripts/install.sh -o /tmp/beads-install.sh
    bash /tmp/beads-install.sh
    rm -f /tmp/beads-install.sh
  fi
fi

# mise's global config lives at ~/.config/mise/config.toml, which doesn't
# fit the flat *.symlink -> ~/.name convention used above, so link it
# explicitly.
mkdir -p "$HOME/.config/mise"
link_file "$DOTFILES_ROOT/mise/config.toml" "$HOME/.config/mise/config.toml"

# Migration notice: toolchain.zsh used to unconditionally `eval pyenv init`.
# That's gone (see docs/adr/0001-no-pyenv.md - we use mise for Python
# versions and uv for packages/venvs now). On a machine that still has pyenv
# installed, just warn rather than touching it - don't silently uninstall or
# unlink someone's existing setup.
if [ -d "$HOME/.pyenv" ] || command -v pyenv >/dev/null 2>&1; then
  warn "pyenv detected on this machine, but toolchain.zsh no longer initializes it (see docs/adr/0001-no-pyenv.md)"
  warn "Python versions now go through mise (mise use python@x.y); packages/venvs through uv."
  warn "pyenv-managed environments will keep working until you migrate, but won't be added to PATH by new shells."
fi

info "done"
